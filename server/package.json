{
  "name": "roadfix-server",
  "version": "1.0.0",
  "description": "Backend API for Roadfix - 24/7 Roadside Vehicle Assistance & Mechanic Dispatch",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm --prefix ../client install && npm --prefix ../client run build && tsc",
    "start": "node dist/server.js"
  },
  "keywords": [
    "roadfix",
    "roadside-assistance",
    "mechanic-booking",
    "ai-diagnosis"
  ],
  "author": "Roadfix Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^9.10.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
